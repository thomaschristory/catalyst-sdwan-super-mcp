# Copy to .env and fill in your vManage credentials.
#
# These env vars are read directly — no sdwan-mcp.yaml is required. They also
# work when exported in your shell or set in your MCP client's `env` block.
# Defaults below match the Cisco DevNet always-on SD-WAN sandbox:
#   https://developer.cisco.com/sdwan/sandbox/
# Replace with your own credentials when pointing at a real vManage.

VMANAGE_USERNAME=devnetuser
VMANAGE_PASSWORD=RG!_Yw919_83

# Optional connection overrides (defaults shown; only needed for a non-sandbox
# vManage). Env vars override the YAML file when both are present.
# VMANAGE_HOST=sandbox-sdwan-2.cisco.com
# VMANAGE_PORT=443
# VMANAGE_VERIFY_SSL=false
# VMANAGE_USE_JWT=true
# VMANAGE_TIMEOUT=30

# Shared bearer token for HTTP-transport auth (sse, streamable-http).
# Only required when transport.auth.type=bearer in sdwan-mcp.yaml.
SDWAN_MCP_TOKEN=
